      "system": {
        "description": {
          "value": "<p style=\"text-align: justify;\">Maior e mais pesada que a espada longa, esta arma &eacute; tradicionalmente usada pelos cavaleiros de Bielefeld. A espada bastarda &eacute; uma arma <em>adapt&aacute;vel</em>. &Eacute; muito grande para ser usada com uma s&oacute; m&atilde;o sem treinamento especial; por isso &eacute; uma arma ex&oacute;tica. Ela pode ser usada como uma arma marcial de duas m&atilde;os.</p>",
          "chat": "",
          "unidentified": ""
        },
        "source": "T20, pg. 147 (JdA)",
        "equipado": 0,
        "equipado2": {
